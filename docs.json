    },
    {
      "source": "/introduction/renewals-and-subscriptions",
      "destination": "/dashboard/renewals"
    },
    {
      "source": "/introduction/thornode-economics",
      "destination": "/reference/plans-and-limits"
    },
    {
      "source": "/infrastructure/asgard-vision",
      "destination": "/products/thoredge-rpc"
    },
    {
      "source": "/infrastructure/bifrost-api/:slug*",
      "destination": "/products/private-transactions"
    },
    {
      "source": "/infrastructure/bifrost-api",
      "destination": "/products/private-transactions"
    },
    {
      "source": "/infrastructure/fastgate-rpc/:slug*",
      "destination": "/products/thoredge-rpc"
    },
    {
      "source": "/infrastructure/fastgate-rpc",
      "destination": "/products/thoredge-rpc"
    },
    {
      "source": "/infrastructure/thor-shredstream/:slug*",
