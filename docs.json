    },
    {
      "source": "/infrastructure/thorstreamer-grpc",
      "destination": "/reference/legacy-services"
    },
    {
      "source": "/infrastructure/thorpulse-nats/:slug*",
      "destination": "/reference/legacy-services"
    },
    {
      "source": "/infrastructure/thorpulse-nats",
      "destination": "/reference/legacy-services"
    },
    {
      "source": "/infrastructure/tools/helm-ps",
      "destination": "/reference/legacy-services"
    },
    {
      "source": "/infrastructure/tools/thorstreamer-yellowstone-translator",
      "destination": "/reference/legacy-services"
    },
    {
      "source": "/infrastructure/tools",
      "destination": "/reference/legacy-services"
    },
    {
      "source": "/guides/:slug*",
      "destination": "/getting-started/quickstart"
    },
    {
      "source": "/collaborator-program/:slug*",
      "destination": "/reference/troubleshooting"
    },
    {
      "source": "/thornode-cloud/terms-of-service",
      "destination": "/legal/terms"
    },
    {
      "source": "/thornode-cloud/thornode-cloud-privacy-policy",
      "destination": "/legal/privacy"
    },
    {
      "source": "/thornode-cloud/thornode-cloud-refund-policy",
      "destination": "/legal/refunds"
    },
    {
      "source": "/thornode-cloud/:slug*",
      "destination": "/legal/policies"
