{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "ThorNode Developer Docs",
  "description": "Query Solana, stream transactions, receive raw shreds, and integrate transaction routes with ThorNode.",
  "colors": {
    "primary": "#92400E",
    "light": "#FBB03B",
    "dark": "#D97706"
  },
  "favicon": "/logo/thornode-blue-icon.svg",
  "logo": {
    "light": "/logo/thornode-blue-light.svg",
    "dark": "/logo/thornode-blue-dark.svg"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "icon": "rocket",
        "pages": [
          "index",
          "getting-started/quickstart",
          "getting-started/choose-a-product",
          "getting-started/access-model"
        ]
      },
      {
        "group": "RPC & account data",
        "icon": "code",
        "pages": ["products/thoredge-rpc", "products/fastgate-account-api"]
      },
      {
        "group": "Data streams",
        "icon": "wave-pulse",
        "pages": ["products/yellowstone-grpc", "products/pulse"]
      },
      {
        "group": "Raw Shred Stream",
        "icon": "layer-group",
        "root": "products/raw-shred-stream",
        "expanded": true,
        "pages": ["products/shredreplay"]
      },
      {
        "group": "Transaction routes",
        "icon": "route",
        "pages": ["products/bifrost-transaction-routes"]
      },
      {
        "group": "Dashboard",
        "icon": "gauge-high",
        "pages": [
          "dashboard/overview",
          "dashboard/endpoints",
          "dashboard/wallets",
          "dashboard/usage-and-limits",
          "dashboard/rentals",
          "dashboard/renewals"
        ]
      },
      {
        "group": "Operate",
        "icon": "book-open",
        "pages": [
          "reference/plans-and-limits",
          "reference/locations",
          "reference/security",
          "reference/troubleshooting"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/thorlabsDev",
          "icon": "github"
        },
        {
          "anchor": "Discord",
          "href": "https://discord.gg/thorlabs",
          "icon": "discord"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@thornode.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Start building",
      "href": "https://www.thornode.io"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "mcp"]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/thor_labs",
      "github": "https://github.com/thorlabsDev",
      "discord": "https://discord.gg/thorlabs"
    }
  },
  "redirects": [
    {
      "source": "/introduction/welcome/:slug*",
      "destination": "/getting-started/quickstart"
    },
    {
      "source": "/introduction/welcome",
      "destination": "/getting-started/quickstart"
    },
    {
      "source": "/introduction/node-locations-and-access/authentication/:slug*",
      "destination": "/dashboard/endpoints"
    },
    {
      "source": "/introduction/node-locations-and-access/authentication",
      "destination": "/dashboard/endpoints"
    },
    {
      "source": "/introduction/node-locations-and-access/rental-system/:slug*",
      "destination": "/dashboard/rentals"
    },
    {
      "source": "/introduction/node-locations-and-access/rental-system",
      "destination": "/dashboard/rentals"
    },
    {
      "source": "/introduction/node-locations-and-access/troubleshooting",
      "destination": "/reference/troubleshooting"
    },
    {
      "source": "/introduction/node-locations-and-access",
      "destination": "/dashboard/endpoints"
    },
    {
