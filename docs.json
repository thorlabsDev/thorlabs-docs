    {
      "source": "/thornode-cloud",
      "destination": "/legal/policies"
    },
    {
      "source": "/introduction/thornode-cloud-terms-of-service",
      "destination": "/legal/terms"
    },
    {
      "source": "/introduction/thornode-cloud-privacy-policy",
